# Least-privilege login created by the pipeline (role: portal_app). Use the POOLED Neon URL on Vercel.
DATABASE_URL=postgresql://portal_app:CHANGE_ME@ep-xxxx-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Long random string used to sign session cookies (e.g. `openssl rand -hex 32`)
SESSION_SECRET=change-me-to-a-long-random-string
# Optional shared code the client must enter before choosing a persona
DEMO_ACCESS_CODE=halden-2026
