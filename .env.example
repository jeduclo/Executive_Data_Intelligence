# Copy to .env (never commit it). Used by `python pipeline/run.py`.

# Neon "owner" connection string (Dashboard > Connect). Creates tables, roles and policies.
PUBLISH_DATABASE_URL=postgresql://neondb_owner:PASSWORD@ep-xxxx.eu-west-2.aws.neon.tech/neondb?sslmode=require

# Password for the least-privilege login the portal uses (role portal_app). Long and random.
PORTAL_APP_PASSWORD=change-me-to-a-long-random-password

# Optional: post new high-severity exceptions to Teams / Slack (incoming webhook URLs)
# Optional: creates a read-only login `powerbi_reader` for Power BI Desktop
POWERBI_PASSWORD=

TEAMS_WEBHOOK_URL=
SLACK_WEBHOOK_URL=

# Optional: freeze the simulation clock for a reproducible demo
# POC_NOW=2026-10-21T16:00
